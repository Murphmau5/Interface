  "items": [
    { "id": "style.glassmorphism", "kind": "style", "title": "玻璃拟态", "summary": "半透明磨砂面板 + 背景模糊 + 1px 亮边，暗色下降饱和。", "categoryId": "style.family.material", "tags": ["材质系", "毛玻璃", "light/dark"], "confidence": "estimated", "preview": { "v": 2, "kind": "style", "treatment": "glass", "radiusPx": 18, "depth": 10, "durationMs": 280, "easing": "ease-out" }, "prompt": "做一块半透明磨砂面板：底色 55% 透明，背景模糊 20px，1px 亮边，圆角 18，柔和外阴影。只用在浮起的控制层，不要给正文卡片也加毛玻璃；暗色下降饱和并把亮边降到 12% 白。", "source": "知识 §5.1；技术 §3.4/§3.8" },
    { "id": "style.liquid-glass", "kind": "style", "title": "液态玻璃", "summary": "控制层浮于内容之上，边缘高光与折射；预览先以玻璃形态占位。", "categoryId": "style.family.material", "tags": ["材质系", "折射", "占位"], "confidence": "estimated", "reused": true, "unknown": ["radiusPx", "depth"], "preview": { "v": 2, "kind": "style", "treatment": "glass", "radiusPx": 22, "depth": 14, "durationMs": 360, "easing": "cubic-bezier(0.32,0.72,0,1)" }, "prompt": "做一层可流动的控制层：内容从下方穿透，边缘高光与轻微折射，圆角 22，控制条浮在内容之上。只有控制层允许使用；提供 Reduce Transparency 降级为不透明表面。折射强度与透镜参数总清单未给数值，这里只做形态占位。", "source": "知识 §5.1；技术 §3.4" },
    { "id": "style.neumorphism", "kind": "style", "title": "新拟态", "summary": "同色底 + 左上高光、右下暗影的软 UI，低对比、圆润。", "categoryId": "style.family.material", "tags": ["材质系", "软UI", "双阴影"], "confidence": "estimated", "preview": { "v": 2, "kind": "style", "treatment": "neumorphic", "radiusPx": 16, "depth": 12, "durationMs": 320, "easing": "ease-in-out" }, "prompt": "同色底上做软 UI：左上高光、右下暗影，圆角 16，深度 12，整体低对比。背景与表面同色，不要出现高饱和色块或透明层。", "source": "知识 §5.1；技术 §3.4/§3.8" },
    { "id": "style.skeuomorphism", "kind": "style", "title": "拟物化", "summary": "真实材质、物理隐喻与写实光影；纹理资产未定，先以厚阴影占位。", "categoryId": "style.family.material", "tags": ["材质系", "写实", "纹理"], "confidence": "estimated", "reused": true, "unknown": ["depth"], "preview": { "v": 2, "kind": "style", "treatment": "clay", "radiusPx": 20, "depth": 16, "durationMs": 380, "easing": "ease-in-out" }, "prompt": "做一张有真实材质的卡片：纸张/皮革纹理、写实光影、圆角 20，深度 16。纹理与暗色材质资产尚未确定，这里先用厚度与阴影占位；不要把它退化成纯色扁平卡。", "source": "知识 §5.1；技术 §3.3" },
    { "id": "style.claymorphism", "kind": "style", "title": "黏土拟态", "summary": "哑光黏土质感、胖圆角、内外双阴影与漂浮感。", "categoryId": "style.family.material", "tags": ["材质系", "粉彩", "胖圆角"], "confidence": "estimated", "preview": { "v": 2, "kind": "style", "treatment": "clay", "radiusPx": 24, "depth": 14, "durationMs": 340, "easing": "cubic-bezier(0.2,0.8,0.2,1)" }, "prompt": "胖圆角、粉彩填充、内外双阴影，圆角 24，深度 14，带轻微悬浮感。整体哑光、无高光，不要玻璃透明或硬边拟物。", "source": "知识 §5.1；技术 §3.4/§3.8" },
    { "id": "style.flat", "kind": "style", "title": "扁平", "summary": "纯色块、无纹理，靠字号与间距分层；小圆角、零阴影。", "categoryId": "style.family.genre", "tags": ["流派系", "纯色", "零阴影"], "confidence": "estimated", "preview": { "v": 2, "kind": "style", "treatment": "flat", "radiusPx": 4, "depth": 0, "durationMs": 200, "easing": "ease-out" }, "prompt": "纯色块 + 无阴影 + 4px 小圆角，靠字号与间距分层。不要渐变、纹理、重阴影；图标用线性。", "source": "知识 §5.1；技术 §1.1" },
    { "id": "style.minimalism", "kind": "style", "title": "极简", "summary": "大留白、少色、细字重、单一焦点，动效克制。", "categoryId": "style.family.genre", "tags": ["流派系", "留白", "克制动效"], "confidence": "estimated", "preview": { "v": 2, "kind": "style", "treatment": "flat", "radiusPx": 8, "depth": 0, "durationMs": 240, "easing": "ease-out" }, "prompt": "大留白、2–3 色、细字重、单一焦点，圆角 8，零阴影。装饰性插画与多色都去掉；动效保持克制，只做必要的透明度过渡。", "source": "知识 §5.1；技术 §1.1" },
    { "id": "style.brutalism", "kind": "style", "title": "粗野主义", "summary": "裸露结构、系统字体、粗黑边、零圆角与错位网格。", "categoryId": "style.family.genre", "tags": ["流派系", "粗边框", "系统字体"], "confidence": "estimated", "preview": { "v": 2, "kind": "style", "treatment": "brutalism", "radiusPx": 0, "depth": 0, "durationMs": 180, "easing": "linear" }, "prompt": "裸露结构：系统字体、粗黑边、零圆角、原色块、错位网格。不要圆润可爱，也不要做玻璃质感。", "source": "知识 §5.1；技术 §1.1" },
    { "id": "style.neobrutalism", "kind": "style", "title": "新粗野主义", "summary": "2px 黑边 + 硬偏移阴影 + 高饱和色块，纸片感。", "categoryId": "style.family.genre", "tags": ["流派系", "硬阴影", "高饱和"], "confidence": "estimated", "preview": { "v": 2, "kind": "style", "treatment": "neobrutalism", "radiusPx": 12, "depth": 8, "durationMs": 220, "easing": "ease-out" }, "prompt": "2px 黑边 + 8px 硬偏移阴影 + 高饱和色块，圆角 12。阴影不带模糊，保持纸片感；不要退成纯粗野的无样式。", "source": "知识 §5.1；技术 §1.1" },
    { "id": "style.editorial", "kind": "style", "title": "编辑式", "summary": "杂志式字号对比、栏网格、引文与图注，长文阅读节奏。", "categoryId": "style.family.genre", "tags": ["流派系", "杂志排版", "字阶"], "confidence": "estimated", "preview": { "v": 2, "kind": "style", "treatment": "editorial", "radiusPx": 10, "depth": 4, "durationMs": 400, "easing": "cubic-bezier(0.4,0,0.2,1)" }, "prompt": "杂志式排版：大标题衬线、栏网格、引文与图注，字阶比 1.6，圆角 10。不要仪表盘式密集控件；行高放松，长文阅读优先。", "source": "知识 §5.1；技术 §3.8" },
    { "id": "style.tactile", "kind": "style", "title": "触感设计", "summary": "反扁平的纹理、颗粒、微 3D 与暖色手作感。", "categoryId": "style.family.genre", "tags": ["流派系", "颗粒", "暖色"], "confidence": "estimated", "unknown": ["depth"], "preview": { "v": 2, "kind": "style", "treatment": "clay", "radiusPx": 18, "depth": 18, "durationMs": 360, "easing": "ease-in-out" }, "prompt": "反扁平的手作感：暖色盘、颗粒纹理、微 3D，圆角 18，深度 18。颗粒资产未定，先用厚度与暖色表达；不要纯玻璃或纯扁平。", "source": "知识 §5.1；技术 §3.3" },
    { "id": "style.cyberpunk", "kind": "style", "title": "赛博朋克", "summary": "暗底、霓虹青紫、发光边与扫描线故障感。", "categoryId": "style.family.genre", "tags": ["流派系", "霓虹", "故障"], "confidence": "estimated", "preview": { "v": 2, "kind": "style", "treatment": "neobrutalism", "radiusPx": 6, "depth": 18, "durationMs": 300, "easing": "cubic-bezier(0.4,0,0.2,1)" }, "prompt": "暗底 + 霓虹青紫 + 发光描边 + 扫描线故障，圆角 6，深度 18。只用于氛围展示，不要套到日常生产力页面。", "source": "知识 §5.1；技术 §3.8" },
    { "id": "style.material3", "kind": "style", "title": "Material 3", "summary": "动态色 tonal surface、elevation 分层与 shape scale。", "categoryId": "style.family.platform", "tags": ["平台系", "tonal", "elevation"], "confidence": "estimated", "reused": true, "preview": { "v": 2, "kind": "style", "treatment": "card", "radiusPx": 20, "depth": 6, "durationMs": 260, "easing": "cubic-bezier(0.4,0,0.2,1)" }, "prompt": "M3 风格：动态色 tonal surface、elevation 分层、shape scale，圆角 20，深度 6。需要完整 token 集与组件默认值；这里只演示表面与形状层级。", "source": "知识 §5.1/§4.4；技术 §3.4/§3.8" },
    { "id": "style.fluent2", "kind": "style", "title": "Fluent 2", "summary": "微软中性层、Acrylic 材质、紧凑密度与层次阴影。", "categoryId": "style.family.platform", "tags": ["平台系", "Acrylic", "中性灰"], "confidence": "estimated", "reused": true, "preview": { "v": 2, "kind": "style", "treatment": "glass", "radiusPx": 8, "depth": 8, "durationMs": 240, "easing": "cubic-bezier(0.4,0,0.2,1)" }, "prompt": "微软中性层 + Acrylic 材质：中性灰阶、圆角 8、层次阴影、深度 8。不要 Material 动态色；密度偏紧凑。", "source": "知识 §5.1/§4.4；技术 §3.4" },
    { "id": "style.apple-hig", "kind": "style", "title": "Apple HIG", "summary": "SF 字阶、系统色、克制动效与 Liquid Glass 控制层。", "categoryId": "style.family.platform", "tags": ["平台系", "SF", "Liquid Glass"], "confidence": "estimated", "reused": true, "unknown": ["depth"], "preview": { "v": 2, "kind": "style", "treatment": "glass", "radiusPx": 16, "depth": 12, "durationMs": 320, "easing": "cubic-bezier(0.32,0.72,0,1)" }, "prompt": "Apple 平台观感：SF 字阶、系统色、克制动效、Liquid Glass 控制层，圆角 16。保留安全区；不要 Material/Android 导航范式。折射参数未核到，深度仅作形态占位。", "source": "知识 §5.1/§4.4；技术 §3.4" },
    { "id": "style.harmonyos", "kind": "style", "title": "鸿蒙", "summary": "卡片、原子化服务、一多布局与轻阴影；参数来源待核。", "categoryId": "style.family.platform", "tags": ["平台系", "原子化", "待核"], "confidence": "estimated", "reused": true, "unknown": ["radiusPx", "depth"], "preview": { "v": 2, "kind": "style", "treatment": "card", "radiusPx": 16, "depth": 6, "durationMs": 280, "easing": "ease-out" }, "prompt": "HarmonyOS 卡片与原子化服务：品牌色、卡片圆角 16、轻阴影、深度 6。官方多端参数未核到，数值先按推断占位；不要套 iOS/Android 专属范式。", "source": "知识 §5.1/§8；技术 §3.4" },
    { "id": "style.bento", "kind": "style", "title": "Bento Grid", "summary": "不等尺寸格子拼贴，每格一个信息单元，统一 gap。", "categoryId": "style.family.structure", "tags": ["结构系", "网格", "拼贴"], "confidence": "estimated", "preview": { "v": 2, "kind": "style", "treatment": "bento", "radiusPx": 14, "depth": 6, "durationMs": 300, "easing": "ease-out" }, "prompt": "不等尺寸格子拼贴：4 栏网格、统一 12px gap、每格一个信息单元，圆角 14。不要等高瀑布流或普通列表。", "source": "知识 §5.1；技术 §3.8" },
    { "id": "style.card-based", "kind": "style", "title": "卡片式", "summary": "内容装进独立卡片，卡间留白分组，描边 + 轻阴影。", "categoryId": "style.family.structure", "tags": ["结构系", "卡片", "分组"], "confidence": "estimated", "preview": { "v": 2, "kind": "style", "treatment": "card", "radiusPx": 16, "depth": 8, "durationMs": 280, "easing": "ease-out" }, "prompt": "内容装进独立卡片：描边 + 轻阴影、内边距 16、卡间距 16、圆角 16。不要无边界长列表或整页分栏。", "source": "知识 §5.1；技术 §3.8" },
    { "id": "style.split-column", "kind": "style", "title": "分栏式", "summary": "2–3 栏主次分区，分隔线与 sticky 侧栏，栏宽写 CSS 变量。", "categoryId": "style.family.structure", "tags": ["结构系", "主次分区", "sticky"], "confidence": "estimated", "reused": true, "preview": { "v": 2, "kind": "style", "treatment": "editorial", "radiusPx": 6, "depth": 2, "durationMs": 260, "easing": "ease-in-out" }, "prompt": "2–3 栏主次分区：主栏 + 侧栏、分隔线、sticky 侧栏，圆角 6。栏宽只写 CSS 变量；不要单列信息流或 Bento 拼贴。", "source": "知识 §5.1；技术 §3.8" },

    { "id": "theme.light", "kind": "theme", "title": "浅色主题", "summary": "中性浅底深字的语义 token，对比 ≥4.5:1，轻阴影分层。", "categoryId": "theme.light", "tags": ["主题", "语义token", "对比度"], "confidence": "estimated", "preview": { "v": 2, "kind": "theme", "scene": "light", "durationMs": 900, "holdMs": 600, "easing": "cubic-bezier(0.4,0,0.2,1)" }, "prompt": "实现浅色主题 token：中性浅底、深字、低饱和表面，正文对比 ≥4.5:1，轻阴影。组件只引用语义层，不硬编码颜色。", "source": "知识 §5.3；技术 §1.1" },
    { "id": "theme.dark", "kind": "theme", "title": "深色主题", "summary": "深底浅字，用表面亮度表达层级，阴影降级，不做简单反色。", "categoryId": "theme.dark", "tags": ["主题", "深色", "层级"], "confidence": "estimated", "preview": { "v": 2, "kind": "theme", "scene": "dark", "durationMs": 900, "holdMs": 700, "easing": "cubic-bezier(0.4,0,0.2,1)" }, "prompt": "实现深色主题：深灰底、浅字，用表面亮度表达层级；阴影降级。不要用简单反色，也不要保留浅色主题的高亮阴影。", "source": "知识 §5.3；技术 §1.1" },
    { "id": "theme.system", "kind": "theme", "title": "跟随系统", "summary": "监听 prefers-color-scheme，双 token 同步切换且无闪烁。", "categoryId": "theme.system", "tags": ["主题", "prefers-color-scheme", "无闪烁"], "confidence": "estimated", "preview": { "v": 2, "kind": "theme", "scene": "system", "durationMs": 1200, "holdMs": 800, "easing": "cubic-bezier(0.4,0,0.2,1)" }, "prompt": "实现跟随系统：监听 prefers-color-scheme，双套 token 同步切换，切换时无闪烁，默认跟随系统。不要写死单一主题。", "source": "知识 §5.3；技术 §1.1" },
    { "id": "theme.brand", "kind": "theme", "title": "品牌主题", "summary": "品牌色映射主色与强调色，不改结构参数。", "categoryId": "theme.brand", "tags": ["主题", "品牌色", "对比校验"], "confidence": "estimated", "preview": { "v": 2, "kind": "theme", "scene": "brand", "durationMs": 1000, "holdMs": 700, "easing": "cubic-bezier(0.4,0,0.2,1)" }, "prompt": "把品牌色映射到主色/强调色：seed 色推导 hover、pressed、container 与 on-color，并做对比校验；不改结构参数。", "source": "知识 §5.3；技术 §1.1" },
